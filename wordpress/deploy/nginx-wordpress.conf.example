server {
    listen 80;
    server_name www.gama-software.com;
    return 301 https://gama-software.com$request_uri;
}

server {
    listen 80;
    server_name gama-software.com;
    return 301 https://gama-software.com$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.gama-software.com;
    return 301 https://gama-software.com$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name gama-software.com;

    # ssl_certificate and ssl_certificate_key are managed on the target host.
    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8080;
    }
}
