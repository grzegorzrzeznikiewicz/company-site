#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCHEMA_PATH="$ROOT_DIR/config/extensions.schema.json"

if [[ "$#" -gt 1 ]]; then
  echo "Usage: wordpress/bin/validate-extensions-lock [lock-file]" >&2
  exit 64
fi

lock_input="${1:-$ROOT_DIR/config/extensions.lock.json}"
lock_dir="$(cd "$(dirname "$lock_input")" && pwd)"
lock_path="$lock_dir/$(basename "$lock_input")"
if [[ ! -f "$lock_path" ]]; then
  echo "Extension lock does not exist: $lock_path" >&2
  exit 66
fi

exec docker run --rm \
  --volume "$ROOT_DIR/config:/validation:ro" \
  --volume "$lock_path:/input/extensions.lock.json:ro" \
  --entrypoint php \
  wordpress:cli-2.12.0-php8.4 \
  /validation/validate-extensions-lock.php \
  /validation/extensions.schema.json \
  /input/extensions.lock.json
