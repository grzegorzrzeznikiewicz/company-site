#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="$ROOT_DIR/.env"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Missing $ENV_FILE. Copy wordpress/.env.example to wordpress/.env first." >&2
  exit 1
fi

exec docker compose \
  --project-name gama-wordpress \
  --env-file "$ENV_FILE" \
  --file "$ROOT_DIR/compose.yaml" \
  "$@"
