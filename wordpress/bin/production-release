#!/usr/bin/env python3
"""Root-installed entry point. Request is JSON data on stdin, never shell."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from wordpress.release.github_source import json_object, require
from wordpress.release.host import STATE_ROOT, execute, read_json
from wordpress.release.host_ops import HostOps, recovery_comment


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--config')
    parser.add_argument('--recovery-comment', action='store_true')
    args = parser.parse_args()
    raw = sys.stdin.buffer.read(1024 * 1024 + 1)
    require(len(raw) <= 1024 * 1024, 'request too large')
    if args.recovery_comment:
        require(args.config is None, 'formatter does not accept host configuration')
        print(recovery_comment(json_object(raw)))
        return 0
    require(args.config is not None, 'protected host configuration is required')
    config = read_json(Path(args.config))
    result = execute(json_object(raw), STATE_ROOT, HostOps(config))
    print(json.dumps(result, sort_keys=True))
    return 1 if result['status'] == 'failed' else 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as error:
        print('Production release refused: ' + type(error).__name__, file=sys.stderr)
        sys.exit(1)
