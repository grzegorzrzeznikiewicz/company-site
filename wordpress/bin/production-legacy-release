#!/usr/bin/env python3
"""Root-installed fixed legacy transaction; JSON stdin only."""
import json
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from wordpress.release.github_source import json_object, require
from wordpress.release.host import STATE_ROOT, read_json, protected
from wordpress.release.legacy import execute, LegacyOps

if __name__ == '__main__':
    try:
        require(len(sys.argv) == 1, 'legacy entry accepts no command/path arguments')
        raw = sys.stdin.buffer.read(1024 * 1024 + 1)
        require(len(raw) <= 1024 * 1024, 'legacy request too large')
        config = protected(STATE_ROOT / 'legacy-config.json')
        require(config.stat().st_mode & 0o077 == 0, 'legacy config must be root-private')
        result = execute(json_object(raw), STATE_ROOT, LegacyOps(read_json(config)))
        print(json.dumps(result, sort_keys=True))
        sys.exit(0 if result['status'] == 'completed' else 1)
    except Exception as error:
        print('Legacy release refused: ' + type(error).__name__, file=sys.stderr)
        sys.exit(1)
