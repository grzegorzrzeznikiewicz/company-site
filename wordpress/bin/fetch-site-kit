#!/usr/bin/env bash
set -euo pipefail

# Makes the pinned Site Kit by Google release (GSWEB-31) available to the local
# Compose stack, which mounts it read-only. The production image fetches the
# same archive in wordpress/runtime/Dockerfile; both pins must match
# wordpress/config/extensions.lock.json (see wordpress/tests/site-kit-contract.sh).
# The plugin code is never committed: it lives in the ignored wordpress/.cache.

SITE_KIT_VERSION='1.192.0'
SITE_KIT_SHA256='da9c8424b90fc700b09484c20a13aaa3e4ea75edd05a175bf100c6484daee064'
SITE_KIT_URL="https://downloads.wordpress.org/plugin/google-site-kit.${SITE_KIT_VERSION}.zip"

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CACHE_DIR="$ROOT_DIR/.cache/extensions"
TARGET_DIR="$CACHE_DIR/google-site-kit"
STAMP_FILE="$CACHE_DIR/google-site-kit.sha256"

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

if [[ -f "$STAMP_FILE" && -f "$TARGET_DIR/google-site-kit.php" ]] &&
  [[ "$(cat "$STAMP_FILE")" == "$SITE_KIT_SHA256" ]]; then
  exit 0
fi

for tool in curl unzip; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "fetch-site-kit requires $tool." >&2
    exit 69
  fi
done

mkdir -p "$CACHE_DIR"
work_dir="$(mktemp -d "$CACHE_DIR/.google-site-kit.XXXXXX")"
cleanup() {
  rm -rf "$work_dir"
}
trap cleanup EXIT

archive="$work_dir/google-site-kit.zip"
curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
  --output "$archive" "$SITE_KIT_URL"

actual_sha256="$(sha256_of "$archive")"
if [[ "$actual_sha256" != "$SITE_KIT_SHA256" ]]; then
  echo "Site Kit archive checksum mismatch: expected $SITE_KIT_SHA256, got $actual_sha256." >&2
  exit 1
fi

unzip -q "$archive" -d "$work_dir/extract"
if ! grep -Eq "^ \\* Version: +${SITE_KIT_VERSION//./\\.}\$" "$work_dir/extract/google-site-kit/google-site-kit.php"; then
  echo "Site Kit archive does not declare version $SITE_KIT_VERSION." >&2
  exit 1
fi
find "$work_dir/extract/google-site-kit" -type d -exec chmod 0755 {} +
find "$work_dir/extract/google-site-kit" -type f -exec chmod 0644 {} +

rm -rf "$TARGET_DIR" "$STAMP_FILE"
mv "$work_dir/extract/google-site-kit" "$TARGET_DIR"
printf '%s\n' "$SITE_KIT_SHA256" >"$STAMP_FILE"
echo "Site Kit by Google $SITE_KIT_VERSION is ready in $TARGET_DIR."
