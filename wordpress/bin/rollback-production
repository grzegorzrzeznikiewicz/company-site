#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ( "$#" -ne 10 && "$#" -ne 12 ) || "$1" != '--project' || "$3" != '--env-file' || "$5" != '--image' || "$7" != '--http-port' || "$9" != '--confirm-image' || ( "$#" -eq 12 && "${11}" != '--rehearsal-fixture' ) ]]; then
  echo 'Usage: wordpress/bin/rollback-production --project gama-wp-production --env-file <absolute-path> --image <previous-immutable-image> --http-port 8000 --confirm-image <previous-immutable-image> [--rehearsal-fixture <absolute-dir>]' >&2
  exit 64
fi
if [[ "$#" -eq 10 && "$2" != 'gama-wp-production' ]]; then
  echo 'Production code rollback is limited to the stable namespace.' >&2
  exit 64
fi
if [[ "$#" -eq 12 && ( "$2" == 'gama-wp-production' || ! "$2" =~ ^gama-wp-production-candidate-test-[a-z0-9][a-z0-9-]{7,39}$ ) ]]; then
  echo 'Rehearsal rollback is limited to an owned candidate-test namespace.' >&2
  exit 64
fi

echo 'Rolling application code back while retaining the production database and uploads.'
# The deploy helper defaults to code installation only. This wrapper's strict
# argv deliberately does not accept --bootstrap, even for rehearsal recovery.
exec "$ROOT_DIR/bin/deploy-production" "$@"
