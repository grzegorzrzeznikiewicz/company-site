#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "$#" -ne 3 ]]; then
  echo 'Usage: wordpress/bin/require-ci-package <plugin gama-contact|theme gama-software> <artifact.zip>' >&2
  exit 64
fi

package_type="$1"
package_slug="$2"
artifact_path="$3"

case "$package_type:$package_slug" in
  plugin:gama-contact)
    version_file="$ROOT_DIR/plugins/gama-contact/gama-contact.php"
    version="$(sed -nE 's/^[[:space:]]*\*[[:space:]]*Version:[[:space:]]*([^[:space:]]+)[[:space:]]*$/\1/p' "$version_file")"
    ;;
  theme:gama-software)
    version_file="$ROOT_DIR/theme/gama-software/style.css"
    version="$(sed -nE 's/^[[:space:]]*Version:[[:space:]]*([^[:space:]]+)[[:space:]]*$/\1/p' "$version_file")"
    ;;
  *)
    echo 'Usage: wordpress/bin/require-ci-package <plugin gama-contact|theme gama-software> <artifact.zip>' >&2
    exit 64
    ;;
esac

if [[ ! "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  echo "Package source must declare exactly one strict SemVer version: $version_file" >&2
  exit 64
fi

expected_name="$package_slug-$version.zip"
if [[ "$(basename "$artifact_path")" != "$expected_name" ]]; then
  echo "CI package input must match source version: $expected_name" >&2
  exit 64
fi

if ! dist_dir="$(cd "$ROOT_DIR/dist" && pwd -P)" \
  || ! artifact_dir="$(cd "$(dirname "$artifact_path")" && pwd -P)" \
  || [[ "$artifact_dir" != "$dist_dir" ]] \
  || [[ -L "$artifact_path" ]] \
  || [[ ! -f "$artifact_path" ]]; then
  echo "Required CI package is missing or unsafe: $artifact_path" >&2
  exit 66
fi

printf '%s\n' "$artifact_path"
