#!/bin/sh
set -eu

cd /var/www/html

if ! wp core is-installed --allow-root; then
  wp core install --allow-root \
    --url="$WP_HOME" \
    --title="$WP_SITE_TITLE" \
    --admin_user="$WP_ADMIN_USER" \
    --admin_password="$WP_ADMIN_PASSWORD" \
    --admin_email="$WP_ADMIN_EMAIL" \
    --skip-email
fi

wp theme activate gama-software --allow-root
wp plugin activate gama-local-mailpit --allow-root
