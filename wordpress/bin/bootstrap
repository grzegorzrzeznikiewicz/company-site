#!/bin/sh
set -eu

cd /var/www/html

wp_cli() {
  wp --allow-root --url="$WP_HOME" "$@"
}

if ! wp_cli core is-installed; then
  wp_cli core install \
    --title="$WP_SITE_TITLE" \
    --admin_user="$WP_ADMIN_USER" \
    --admin_password="$WP_ADMIN_PASSWORD" \
    --admin_email="$WP_ADMIN_EMAIL" \
    --skip-email
fi

wp_cli theme activate gama-software
wp_cli plugin activate gama-local-mailpit
