#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "$#" -ne 1 ]]; then
  echo "Usage: wordpress/bin/test-package <gama-contact-0.1.0.zip|gama-software-X.Y.Z.zip>" >&2
  exit 64
fi

if ! dist_dir="$(cd "$ROOT_DIR/dist" && pwd -P)"; then
  echo "Canonical artifact directory does not exist: $ROOT_DIR/dist" >&2
  exit 64
fi
if ! zip_dir="$(cd "$(dirname "$1")" && pwd -P)"; then
  echo "Artifact parent directory does not exist: $(dirname "$1")" >&2
  exit 64
fi
zip_path="$zip_dir/$(basename "$1")"
artifact_name="$(basename "$zip_path")"
case "$artifact_name" in
  gama-contact-0.1.0.zip)
    package_kind=plugin
    package_version=0.1.0
    project_prefix=gama-package
    COMPOSE_FILE="$ROOT_DIR/tests/package-compose.yaml"
    site_url=http://gama-package.test
    admin_user=package-admin
    admin_password=package-test-password-only
    ;;
  gama-software-*.zip)
    if [[ ! "$artifact_name" =~ ^gama-software-((0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))\.zip$ ]]; then
      echo "Unsupported package artifact: $artifact_name" >&2
      exit 64
    fi
    package_kind=theme
    package_version="${BASH_REMATCH[1]}"
    project_prefix=gama-theme-package
    COMPOSE_FILE="$ROOT_DIR/tests/theme-package-compose.yaml"
    site_url=http://wordpress
    admin_user=theme-admin
    admin_password=theme-test-password-only
    ;;
  *)
    echo "Unsupported package artifact: $artifact_name" >&2
    exit 64
    ;;
esac
if [[ "$zip_dir" != "$dist_dir" \
  || -L "$zip_path" \
  || ! -f "$zip_path" ]]; then
  echo "Expected a supported regular, non-symlink package ZIP directly in $dist_dir." >&2
  exit 64
fi
if [[ "$package_kind" == theme ]]; then
  if ! command -v unzip >/dev/null 2>&1; then
    echo "The unzip command is required to verify a theme artifact." >&2
    exit 69
  fi
  if [[ "$(unzip -Z1 "$zip_path" | grep -Fxc 'gama-software/style.css')" -ne 1 ]]; then
    echo "Theme artifact must contain exactly one gama-software/style.css." >&2
    exit 64
  fi
  theme_header="$(unzip -p "$zip_path" gama-software/style.css)"
  archive_version="$(sed -nE 's/^[[:space:]]*Version:[[:space:]]*([^[:space:]]+)[[:space:]]*$/\1/p' <<<"$theme_header")"
  if [[ ! "$archive_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ \
    || "$archive_version" != "$package_version" ]]; then
    echo "Theme artifact filename and its single strict SemVer header must match." >&2
    exit 64
  fi
  if command -v shasum >/dev/null 2>&1; then
    sha256_stream() { shasum -a 256 | cut -d' ' -f1; }
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256_stream() { sha256sum | cut -d' ' -f1; }
  else
    echo "A SHA-256 command (shasum or sha256sum) is required." >&2
    exit 69
  fi
  archive_theme_hash_lines=''
  while IFS= read -r archive_entry; do
    if [[ "$archive_entry" == 'gama-software/' || "$archive_entry" == */ ]]; then
      continue
    fi
    if [[ "$archive_entry" != gama-software/* ]]; then
      echo "Theme artifact contains an entry outside gama-software/: $archive_entry" >&2
      exit 64
    fi
    archive_hash="$(unzip -p "$zip_path" "$archive_entry" | sha256_stream)"
    archive_theme_hash_lines+="${archive_entry#gama-software/}:$archive_hash"$'\n'
  done < <(unzip -Z1 "$zip_path")
  archive_theme_hashes="$(printf '%s' "$archive_theme_hash_lines" | LC_ALL=C sort)"
  if [[ -z "$archive_theme_hashes" ]]; then
    echo "Theme artifact contains no files to compare after installation." >&2
    exit 64
  fi
fi

project_name="${project_prefix}-$(date +%s)-$$-${RANDOM}"
if [[ ! "$project_name" =~ ^gama-(package|theme-package)-[0-9]+-[0-9]+-[0-9]+$ || "$project_name" == "gama-wordpress" ]]; then
  echo "Refusing unsafe disposable Compose project name: $project_name" >&2
  exit 1
fi

export PACKAGE_ZIP="$zip_path"
COMPOSE=(docker compose --project-name "$project_name" --file "$COMPOSE_FILE")
PLAYWRIGHT_TEST=(
  env
  -u PW_TEST_SOURCE_TRANSFORM
  -u PW_TEST_SOURCE_TRANSFORM_SCOPE
  -u PW_TEST_REPORTER
  -u PWDEBUG
  node ./specs/support/run-playwright.cjs
)

query_project_resource_ids() {
  local resource_kind="$1"
  local project_filter="label=com.docker.compose.project=$project_name"

  case "$resource_kind" in
    container)
      docker container ls --all --quiet --filter "$project_filter"
      ;;
    volume)
      docker volume ls --quiet --filter "$project_filter"
      ;;
    network)
      docker network ls --quiet --filter "$project_filter"
      ;;
    image)
      docker image ls --quiet --filter "$project_filter"
      ;;
    *)
      echo "Unsupported Docker resource kind: $resource_kind" >&2
      return 64
      ;;
  esac
}

assert_project_absent() {
  local resource_kind resource_ids query_status
  local resource_kinds=(container volume network)

  if [[ "$package_kind" == theme ]]; then
    resource_kinds+=(image)
  fi

  for resource_kind in "${resource_kinds[@]}"; do
    resource_ids="$(query_project_resource_ids "$resource_kind")" || {
      query_status=$?
      echo "Could not query pre-existing $resource_kind resources for $project_name." >&2
      return "$query_status"
    }
    if [[ -n "$resource_ids" ]]; then
      echo "Refusing to start: disposable project label already has $resource_kind resources: $project_name" >&2
      printf '%s\n' "$resource_ids" >&2
      return 1
    fi
  done
}

collect_browser_artifacts() {
  local artifact_root="${GAMA_THEME_ARTIFACT_ROOT:-${TMPDIR:-/tmp}/codex-gsweb12-artifacts}"
  local artifact_directory="$artifact_root/$project_name"
  local artifact_archive="$artifact_directory/browser-artifacts.tar"
  local partial_archive="$artifact_archive.partial"
  local volume_ids volume_id command_status

  volume_ids="$(docker volume ls --quiet \
    --filter "label=com.docker.compose.project=$project_name" \
    --filter "name=^${project_name}_browser-artifacts$")" || {
    command_status=$?
    echo "Could not query the browser artifact volume for $project_name." >&2
    return "$command_status"
  }
  if [[ -z "$volume_ids" ]]; then
    echo "No browser artifact volume exists for $project_name; nothing can be collected." >&2
    return 0
  fi
  if [[ "$(wc -l <<<"$volume_ids" | tr -d '[:space:]')" -ne 1 ]]; then
    echo "Expected exactly one labelled browser artifact volume for $project_name." >&2
    printf '%s\n' "$volume_ids" >&2
    return 1
  fi
  volume_id="$volume_ids"
  if [[ "$volume_id" != "${project_name}_browser-artifacts" ]]; then
    echo "Refusing unexpected labelled artifact volume: $volume_id" >&2
    return 1
  fi
  mkdir -p "$artifact_directory" || return $?
  if [[ -e "$artifact_archive" || -L "$artifact_archive" || -e "$partial_archive" || -L "$partial_archive" ]]; then
    echo "Refusing to overwrite an existing browser artifact archive for $project_name." >&2
    return 1
  fi

  docker run --rm --network none \
    --volume "$volume_id:/artifacts:ro" \
    --entrypoint tar \
    wordpress:cli-2.12.0-php8.4@sha256:1e1d1485277d15e0331b598b6e19972243128ead978b7134d758097d82116b99 \
    -C /artifacts -cf - . >"$partial_archive"
  command_status=$?
  if [[ "$command_status" -ne 0 ]]; then
    unlink "$partial_archive" 2>/dev/null || true
    echo "Browser artifact collection failed with status $command_status for $project_name." >&2
    return "$command_status"
  fi
  mv "$partial_archive" "$artifact_archive" || return $?
  echo "Collected complete browser artifact volume: $artifact_archive"
}

echo "Disposable Compose project: $project_name"
assert_project_absent
echo "Disposable project label is unused before start."

cleanup() {
  local test_status=$?
  local cleanup_status=0
  local command_status resource_kind remaining_resources
  local resource_kinds=(container volume network)

  if [[ "$package_kind" == theme ]]; then
    resource_kinds+=(image)
  fi

  set +e
  echo "Cleaning only disposable Compose project: $project_name"
  if [[ "$package_kind" == theme ]]; then
    collect_browser_artifacts
    command_status=$?
    if [[ "$command_status" -ne 0 && "$cleanup_status" -eq 0 ]]; then
      cleanup_status=$command_status
    fi
  fi
  "${COMPOSE[@]}" ps --all
  command_status=$?
  if [[ "$command_status" -ne 0 && "$cleanup_status" -eq 0 ]]; then
    cleanup_status=$command_status
  fi
  if [[ "$package_kind" == theme ]]; then
    "${COMPOSE[@]}" down --volumes --remove-orphans --rmi local
  else
    "${COMPOSE[@]}" down --volumes --remove-orphans
  fi
  command_status=$?
  if [[ "$command_status" -ne 0 && "$cleanup_status" -eq 0 ]]; then
    cleanup_status=$command_status
  fi
  for resource_kind in "${resource_kinds[@]}"; do
    remaining_resources="$(query_project_resource_ids "$resource_kind")"
    command_status=$?
    if [[ "$command_status" -ne 0 ]]; then
      echo "Could not verify cleanup of $resource_kind resources for $project_name." >&2
      if [[ "$cleanup_status" -eq 0 ]]; then
        cleanup_status=$command_status
      fi
    elif [[ -n "$remaining_resources" ]]; then
      echo "Disposable project cleanup left labelled $resource_kind resources behind." >&2
      printf '%s\n' "$remaining_resources" >&2
      if [[ "$cleanup_status" -eq 0 ]]; then
        cleanup_status=1
      fi
    fi
  done
  set -e
  trap - EXIT
  if [[ "$test_status" -ne 0 ]]; then
    exit "$test_status"
  fi
  exit "$cleanup_status"
}
trap cleanup EXIT

wp_cmd() {
  local output status=0
  output="$("${COMPOSE[@]}" run --rm --no-deps wp "$@" 2>&1)" || status=$?
  printf '%s\n' "$output"
  if grep -Eqi '(^|[[:space:]])(PHP[[:space:]]+)?(warning|notice|deprecated|fatal)(:|[[:space:]])|fatal error|uncaught' <<<"$output"; then
    return 1
  fi
  return "$status"
}

first_inactive_core_theme() {
  local candidate inactive_themes
  inactive_themes="$(wp_cmd theme list --status=inactive --field=name)" || return $?
  while IFS= read -r candidate; do
    if [[ "$candidate" == twenty* ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done <<<"$inactive_themes"
  return 1
}

"${COMPOSE[@]}" up --detach --wait db wordpress

wp_cmd core install \
  --url="$site_url" \
  --title='Gama package test' \
  --admin_user="$admin_user" \
  --admin_password="$admin_password" \
  --admin_email=package-admin@example.test \
  --skip-email

wp_cmd core version | grep -Fx '7.1'
wp_cmd eval 'if (version_compare(PHP_VERSION, "8.4", "<") || version_compare(PHP_VERSION, "8.5", ">=")) { exit(1); } echo PHP_VERSION;' | grep -E '^8\.4\.'

if [[ "$package_kind" == theme ]]; then
  offline_update_eval='$now = time(); $core = (object) ["last_checked" => $now, "version_checked" => get_bloginfo("version"), "updates" => []]; $extensions = (object) ["last_checked" => $now, "checked" => [], "response" => [], "no_update" => [], "translations" => []]; set_site_transient("update_core", $core, DAY_IN_SECONDS); set_site_transient("update_plugins", $extensions, DAY_IN_SECONDS); set_site_transient("update_themes", $extensions, DAY_IN_SECONDS); echo "offline-update-transients-ok";'
  install_offline_translation_guard() {
    wp_cmd eval '$directory = WP_CONTENT_DIR . "/mu-plugins"; if (!is_dir($directory) && !mkdir($directory, 0755, true)) { exit(1); } $code = "<?php\nadd_filter( \"translations_api\", static fn () => array( \"translations\" => array() ) );\n"; if (file_put_contents($directory . "/gama-offline-translation-harness.php", $code) === false) { exit(1); } echo "offline-translation-guard-installed";' | grep -Fx 'offline-translation-guard-installed'
  }
  remove_offline_translation_guard() {
    wp_cmd eval '$file = WP_CONTENT_DIR . "/mu-plugins/gama-offline-translation-harness.php"; if (is_file($file) && !unlink($file)) { exit(1); } echo "offline-translation-guard-removed";' | grep -Fx 'offline-translation-guard-removed'
  }
  wp_cmd eval "$offline_update_eval" | grep -Fx 'offline-update-transients-ok'
  install_offline_translation_guard
  wp_cmd theme install /package/gama-software.zip --force
  remove_offline_translation_guard
  wp_cmd theme activate gama-software
  wp_cmd theme get gama-software --field=version | grep -Fx "$package_version"

  installed_contract='require_once ABSPATH . "wp-admin/includes/theme.php";
$fail = static function (string $message): void { fwrite(STDERR, $message . PHP_EOL); exit(1); };
$root = realpath(get_theme_root("gama-software") . "/gama-software");
if ($root !== WP_CONTENT_DIR . "/themes/gama-software") { $fail("Theme is not at the exact installed ZIP path"); }
foreach (["style.css", "functions.php", "theme.json", "templates/index.html", "parts/header.html", "patterns/not-found.php"] as $file) {
    $path = realpath($root . "/" . $file);
    if ($path === false || !str_starts_with($path, $root . DIRECTORY_SEPARATOR)) { $fail("Runtime file escaped installed theme: " . $file); }
}
$walk = static function (array $blocks, string $source) use (&$walk, $fail): void {
    foreach ($blocks as $block) {
        if (($block["blockName"] ?? null) === null) {
            if (trim((string) ($block["innerHTML"] ?? "")) !== "") { $fail("Non-block fragment in " . $source); }
        } else {
            if (!WP_Block_Type_Registry::get_instance()->is_registered($block["blockName"])) { $fail("Unregistered block " . $block["blockName"] . " in " . $source); }
            $walk($block["innerBlocks"] ?? [], $source);
        }
    }
};
foreach (array_merge(glob($root . "/templates/*.html"), glob($root . "/parts/*.html")) as $file) { $walk(parse_blocks(file_get_contents($file)), basename($file)); }
$search_blocks = parse_blocks(file_get_contents($root . "/templates/search.html"));
$find_search = static function (array $blocks) use (&$find_search): ?array { foreach ($blocks as $block) { if (($block["blockName"] ?? null) === "core/search") { return $block; } $found = $find_search($block["innerBlocks"] ?? []); if ($found !== null) { return $found; } } return null; };
$search = $find_search($search_blocks);
if (!is_array($search) || ($search["attrs"] ?? []) !== ["showLabel" => true]) { $fail("Search block does not defer labels to Core localization"); }
$translate_search = static fn ($translation, $text) => $text === "Search" ? "GSWEB12 localized search" : $translation;
add_filter("gettext", $translate_search, 10, 2);
$rendered_search = render_block($search);
remove_filter("gettext", $translate_search, 10);
if (!str_contains($rendered_search, "GSWEB12 localized search")) { $fail("Core-localized Search defaults were not rendered"); }
$pattern = WP_Block_Patterns_Registry::get_instance()->get_registered("gama-software/not-found");
if (!is_array($pattern) || empty($pattern["content"])) { $fail("Theme pattern was not registered"); }
$walk(parse_blocks($pattern["content"]), "registered pattern");
echo "installed-theme-parse-and-provenance-ok";'
  wp_cmd eval "$installed_contract" | grep -Fx 'installed-theme-parse-and-provenance-ok'

  navigation_runtime_body="$(sed '/^<\?php$/d; /^declare(strict_types=1);$/d' "$ROOT_DIR/tests/assert-theme-navigation-runtime.php")"
  navigation_runtime_status=0
  navigation_runtime_output="$(wp_cmd eval "$navigation_runtime_body")" || navigation_runtime_status=$?
  printf '%s\n' "$navigation_runtime_output"
  [[ "$navigation_runtime_status" -eq 0 ]] || exit "$navigation_runtime_status"
  grep -Fx 'installed-navigation-runtime-ok' <<<"$navigation_runtime_output"

  policy_contract='require_once ABSPATH . "wp-admin/includes/user.php";
$fail = static function (string $message): void { fwrite(STDERR, $message . PHP_EOL); exit(1); };
WP_Block_Type_Registry::get_instance()->register(new WP_Block_Type("gama-test/extra"));
$context = new WP_Block_Editor_Context(["name" => "core/edit-site"]);
$admin = get_user_by("login", "theme-admin");
wp_set_current_user($admin->ID);
foreach ([true, false, ["core/html", "core/paragraph"]] as $input) {
    if (gama_software_filter_allowed_blocks($input, $context) !== $input) { $fail("Administrative block policy changed input"); }
}
$settings = ["codeEditingEnabled" => true, "sentinel" => 7];
if (gama_software_filter_editor_settings($settings, $context) !== $settings) { $fail("Administrative editor settings changed"); }
$editor_id = wp_create_user("theme-editor", "test-only-password", "theme-editor@example.test");
$editor = get_user_by("id", $editor_id); $editor->set_role("editor"); wp_set_current_user($editor_id);
if (gama_software_filter_allowed_blocks(false, $context) !== false) { $fail("False policy was not preserved"); }
$array = gama_software_filter_allowed_blocks(["core/html", "core/paragraph"], $context);
if ($array !== ["core/paragraph"]) { $fail("Existing allowlist was widened or filtered incorrectly"); }
$all = gama_software_filter_allowed_blocks(true, $context);
if (!in_array("gama-test/extra", $all, true) || in_array("core/html", $all, true)) { $fail("True policy did not preserve registered blocks minus core/html"); }
$filtered = gama_software_filter_editor_settings(["codeEditingEnabled" => true, "sentinel" => 7], $context);
if (($filtered["codeEditingEnabled"] ?? null) !== false || ($filtered["sentinel"] ?? null) !== 7) { $fail("Editor code policy changed unrelated settings"); }
wp_delete_user($editor_id);
echo "editor-policy-ok";'
  policy_status=0
  policy_output="$(wp_cmd eval "$policy_contract")" || policy_status=$?
  printf '%s\n' "$policy_output"
  [[ "$policy_status" -eq 0 ]] || exit "$policy_status"
  grep -Fx 'editor-policy-ok' <<<"$policy_output"

  global_styles_contract='require_once ABSPATH . "wp-admin/includes/user.php";
$fail = static function (string $message): void { fwrite(STDERR, $message . PHP_EOL); exit(1); };
$theme_data = WP_Theme_JSON_Resolver::get_theme_data();
$theme_settings = $theme_data->get_settings();
$merged_settings = WP_Theme_JSON_Resolver::get_merged_data()->get_settings();
$expected_palette = ["base"=>"#ffffff","surface-subtle"=>"#f9fafb","border-subtle"=>"#e5e7eb","text-strong"=>"#101828","text"=>"#364153","text-muted"=>"#4a5565","text-card-muted"=>"#717182","text-on-dark-muted"=>"#99a1af","surface-inverse"=>"#101828","accent-soft"=>"#dbeafe","accent"=>"#155dfc"];
$expected_fonts = ["small"=>".875rem","body"=>"1rem","button"=>"1.125rem","lead"=>"1.25rem","heading-3"=>"1.5rem","heading-2"=>"2.25rem","display"=>"3rem","display-large"=>"3.75rem"];
$expected_spacing = ["sm"=>".5rem","md"=>"1rem","lg"=>"1.5rem","xl"=>"2rem","xxl"=>"3rem","section"=>"5rem"];
$expected_shadows = ["elevation-1","elevation-2","elevation-3"];
$map = static function (array $items, string $value): array { $mapped=[]; foreach ($items as $item) { $mapped[$item["slug"] ?? ""]=$item[$value] ?? null; } return $mapped; };
if ($map($theme_settings["color"]["palette"]["theme"] ?? [], "color") !== $expected_palette) { $fail("Theme-origin palette differs"); }
if ($map($theme_settings["typography"]["fontSizes"]["theme"] ?? [], "size") !== $expected_fonts) { $fail("Theme-origin font sizes differ"); }
if ($map($theme_settings["spacing"]["spacingSizes"]["theme"] ?? [], "size") !== $expected_spacing) { $fail("Theme-origin spacing differs"); }
if (array_column($theme_settings["shadow"]["presets"]["theme"] ?? [], "slug") !== $expected_shadows) { $fail("Theme-origin shadows differ"); }
if (($theme_settings["typography"]["fontFamilies"]["theme"][0]["slug"] ?? null) !== "system-sans" || count($theme_settings["typography"]["fontFamilies"]["theme"] ?? []) !== 1) { $fail("Theme-origin font family differs"); }
foreach ([["color","custom"],["color","defaultPalette"],["color","customGradient"],["color","defaultGradients"],["color","customDuotone"],["color","defaultDuotone"],["typography","customFontSize"],["typography","defaultFontSizes"],["typography","fontStyle"],["typography","fontWeight"],["typography","letterSpacing"],["typography","lineHeight"],["spacing","customSpacingSize"],["spacing","defaultSpacingSizes"],["shadow","defaultPresets"]] as [$group,$key]) { if (($merged_settings[$group][$key] ?? null) !== false) { $fail("Merged setting is not disabled: $group.$key"); } }
if (($merged_settings["layout"]["contentSize"] ?? null) !== "70rem" || ($merged_settings["layout"]["wideSize"] ?? null) !== "80rem" || ($merged_settings["layout"]["allowCustomContentAndWideSize"] ?? null) !== false) { $fail("Merged layout differs"); }
if (($merged_settings["custom"]["color"]["accentHover"] ?? null) !== "#1447e6" || ($merged_settings["custom"]["radius"]["card"] ?? null) !== ".875rem") { $fail("Merged custom tokens differ"); }
$css = wp_get_global_stylesheet();
foreach (["--wp--preset--color--accent: #155dfc","--wp--preset--font-size--body: 1rem","--wp--preset--spacing--section: 5rem","--wp--preset--shadow--elevation-1:","--wp--custom--color--accent-hover: #1447e6","--wp--custom--radius--card: .875rem"] as $needle) { if (!str_contains($css, $needle)) { $fail("Runtime CSS misses $needle"); } }
if (preg_match("#https?://|@font-face#i", $css)) { $fail("Runtime Global Styles contains a remote request or font face"); }
wp_styles(); wp_scripts();
$admin = get_user_by("login", "theme-admin"); wp_set_current_user($admin->ID);
WP_Block_Type_Registry::get_instance()->register(new WP_Block_Type("gama-test/extra"));
$context = new WP_Block_Editor_Context(["name"=>"core/edit-post"]);
$assert_editor_settings = static function (array $settings, bool $is_admin) use ($fail,$expected_palette,$expected_fonts,$expected_spacing,$expected_shadows,$map): void {
    if ($map($settings["colors"] ?? [], "color") !== $expected_palette || ($settings["gradients"] ?? null) !== [] || $map($settings["fontSizes"] ?? [], "size") !== $expected_fonts || $map($settings["spacingSizes"] ?? [], "size") !== $expected_spacing) { $fail("Editor-facing preset choices differ"); }
    if (($settings["disableCustomColors"] ?? null) !== true || ($settings["disableCustomGradients"] ?? null) !== true || ($settings["disableCustomFontSizes"] ?? null) !== true || ($settings["enableCustomLineHeight"] ?? null) !== false || ($settings["disableCustomSpacingSizes"] ?? null) !== true || ($settings["enableCustomUnits"] ?? null) !== ["px","rem","%"] || ($settings["enableCustomSpacing"] ?? null) !== true) { $fail("Editor-facing arbitrary controls differ"); }
    $features=$settings["__experimentalFeatures"] ?? [];
    if (($features["shadow"]["defaultPresets"] ?? null) !== false || array_column($features["shadow"]["presets"]["theme"] ?? [], "slug") !== $expected_shadows) { $fail("Editor-facing shadows differ"); }
    if (($features["typography"]["fontFamilies"]["theme"][0]["slug"] ?? null) !== "system-sans" || count($features["typography"]["fontFamilies"]["theme"] ?? []) !== 1) { $fail("Editor-facing font family differs"); }
    $allowed=$settings["allowedBlockTypes"] ?? null;
    if ($is_admin && $allowed !== true) { $fail("Administrator block policy changed"); }
    if (!$is_admin && (!is_array($allowed) || in_array("core/html",$allowed,true) || !in_array("gama-test/extra",$allowed,true))) { $fail("Editor block policy removed an allowed extra block or kept Custom HTML"); }
};
$assert_editor_settings(get_block_editor_settings([], $context), true);
$editor_id=wp_create_user("style-editor","test-only-password","style-editor@example.test"); $editor=get_user_by("id",$editor_id); $editor->set_role("editor"); wp_set_current_user($editor_id);
$assert_editor_settings(get_block_editor_settings([], $context), false);
wp_delete_user($editor_id);
if ((string) wp_get_theme("gama-software")->get("Version") !== GAMA_EXPECTED_THEME_VERSION) { $fail("Installed theme version differs from its artifact"); }
