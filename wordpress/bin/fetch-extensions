#!/usr/bin/env bash
set -euo pipefail

# Makes every external extension pinned in wordpress/config/extensions.lock.json
# (GSWEB-31) available to the local Compose stack, which mounts each one
# read-only from the ignored wordpress/.cache/extensions/<slug>. The production
# image fetches the same archives with the same checksums in
# wordpress/runtime/Dockerfile (kept in sync by
# wordpress/tests/external-extensions-contract.sh). Plugin code is never committed.

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCK_FILE="$ROOT_DIR/config/extensions.lock.json"
CACHE_DIR="$ROOT_DIR/.cache/extensions"

for tool in curl unzip python3; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "fetch-extensions requires $tool." >&2
    exit 69
  fi
done

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

# One "type slug version source sha256" line per locked extension.
entries="$(python3 -I - "$LOCK_FILE" <<'PY'
import json
import re
import sys

with open(sys.argv[1], encoding='utf-8') as handle:
    lock = json.load(handle)
for entry in lock['extensions']:
    fields = [entry['type'], entry['slug'], entry['version'], entry['source'], entry['sha256']]
    if entry['type'] != 'plugin':
        raise SystemExit('fetch-extensions only supports plugins, got ' + entry['type'])
    if not re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*', entry['slug']):
        raise SystemExit('invalid slug ' + repr(entry['slug']))
    if not re.fullmatch(r'[0-9A-Za-z.+_-]+', entry['version']):
        raise SystemExit('invalid version ' + repr(entry['version']))
    if not re.fullmatch(r'[a-f0-9]{64}', entry['sha256']):
        raise SystemExit('invalid sha256 for ' + entry['slug'])
    if not entry['source'].startswith('https://downloads.wordpress.org/plugin/'):
        raise SystemExit('unexpected source for ' + entry['slug'])
    print(' '.join(fields))
PY
)"

mkdir -p "$CACHE_DIR"
work_dir=''
cleanup() {
  if [[ -n "$work_dir" ]]; then
    rm -rf "$work_dir"
  fi
}
trap cleanup EXIT

while read -r _type slug version source sha256; do
  [[ -n "$slug" ]] || continue
  target_dir="$CACHE_DIR/$slug"
  stamp_file="$CACHE_DIR/$slug.sha256"
  if [[ -f "$stamp_file" && -d "$target_dir" && "$(cat "$stamp_file")" == "$sha256" ]]; then
    continue
  fi

  work_dir="$(mktemp -d "$CACHE_DIR/.$slug.XXXXXX")"
  archive="$work_dir/$slug.zip"
  curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
    --output "$archive" "$source"
  actual_sha256="$(sha256_of "$archive")"
  if [[ "$actual_sha256" != "$sha256" ]]; then
    echo "$slug archive checksum mismatch: expected $sha256, got $actual_sha256." >&2
    exit 1
  fi

  unzip -q "$archive" -d "$work_dir/extract"
  if [[ ! -d "$work_dir/extract/$slug" ]]; then
    echo "$slug archive does not contain a $slug/ directory." >&2
    exit 1
  fi
  main_file="$(grep -l '^[[:space:]]*\*[[:space:]]*Plugin Name:' "$work_dir/extract/$slug"/*.php | head -n 1 || true)"
  if [[ -z "$main_file" ]] || ! grep -Eq "^ \\* Version: +${version//./\\.}\$" "$main_file"; then
    echo "$slug archive does not declare version $version." >&2
    exit 1
  fi
  find "$work_dir/extract/$slug" -type d -exec chmod 0755 {} +
  find "$work_dir/extract/$slug" -type f -exec chmod 0644 {} +

  rm -rf "$target_dir" "$stamp_file"
  mv "$work_dir/extract/$slug" "$target_dir"
  printf '%s\n' "$sha256" >"$stamp_file"
  rm -rf "$work_dir"
  work_dir=''
  echo "$slug $version is ready in $target_dir."
done <<<"$entries"
