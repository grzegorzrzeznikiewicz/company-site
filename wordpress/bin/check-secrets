#!/usr/bin/env bash
set -euo pipefail

repository="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
if [[ ! -d "$repository/.git" && ! -f "$repository/.git" ]]; then
  echo 'Secret scan target must be a Git worktree.' >&2
  exit 64
fi

pattern='-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|AKIA[A-Z0-9]{16}|xox[baprs]-[A-Za-z0-9-]{20,}'
matches="$(git -C "$repository" grep -IlE -- "$pattern" -- . 2>/dev/null || true)"
if [[ -n "$matches" ]]; then
  echo 'Potential committed secret detected in:' >&2
  printf '%s\n' "$matches" >&2
  exit 1
fi

echo 'Tracked-file high-confidence secret scan passed.'
