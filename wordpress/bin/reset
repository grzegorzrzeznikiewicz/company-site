#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

list_targets() {
  echo "Compose containers for project gama-wordpress:"
  "$SCRIPT_DIR/_compose" ps --all
  echo "Named volumes labelled for project gama-wordpress:"
  docker volume ls --filter label=com.docker.compose.project=gama-wordpress
}

if [[ "${1:-}" == "--list-targets" && "$#" -eq 1 ]]; then
  list_targets
  exit 0
fi

if [[ "${1:-}" != "--confirm" || "$#" -ne 1 ]]; then
  echo "Refusing reset. This deletes only the gama-wordpress Compose project's database, uploads, and local WordPress volumes." >&2
  echo "Inspect the exact targets first: wordpress/bin/reset --list-targets" >&2
  echo "Run: wordpress/bin/reset --confirm" >&2
  exit 64
fi

echo "Removing only the gama-wordpress Compose project's disposable local data."
list_targets
exec "$SCRIPT_DIR/_compose" down --volumes --remove-orphans
