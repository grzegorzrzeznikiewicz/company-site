# Copy this file to .env.local and fill in real values.
# On production, set these as environment variables (e.g. GitHub Secrets → deployment).
#
# NEVER commit .env.local — it is git-ignored.

# Database
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/dbname?serverVersion=16&charset=utf8"

# Mail transport
MAILER_DSN="smtp://user:password@smtp.example.com:587"

# Contact form routing
CONTACT_RECIPIENT=your-email@example.com
CONTACT_SENDER=no-reply@example.com

# Admin panel HTTP Basic credentials
# Generate hash: php -r "echo password_hash('your_password', PASSWORD_BCRYPT);"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH="$2y$12$generated_hash_here"
