# Shared frontend runtime
FRONTEND_NODE_VERSION=24.14.0

# Frontend environment variables
# Leave VITE_API_BASE_URL empty to use Vite proxy (/api -> backend)
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8080
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=Admin123!

# Hostname/port used by Vite dev & preview server
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173
