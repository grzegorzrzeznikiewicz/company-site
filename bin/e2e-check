#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

wait_for_url() {
  local url="$1"
  local label="$2"
  local expected_pattern="$3"
  local attempts=30

  while true; do
    local status
    status="$(
      curl --silent --show-error --output /dev/null --write-out '%{http_code}' "$url" || true
    )"

    if [[ "$status" =~ $expected_pattern ]]; then
      return 0
    fi

    attempts=$((attempts - 1))

    if [ "$attempts" -le 0 ]; then
      echo "Timed out waiting for ${label} at ${url}. Last status: ${status}" >&2
      exit 1
    fi

    sleep 2
  done
}

"$SCRIPT_DIR/start"

wait_for_url "http://localhost:5173" "frontend" '^(200)$'
wait_for_url "http://localhost:8080/admin" "backend admin" '^(200|401)$'
wait_for_url "http://localhost:8026" "MailHog" '^(200)$'

compose_network="$(
  "$SCRIPT_DIR/_compose" ps -q frontend |
    xargs docker inspect -f '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' |
    head -n 1
)"

if [ -z "$compose_network" ]; then
  echo "Could not determine Docker Compose network for frontend service." >&2
  exit 1
fi

docker run --rm \
  --network "$compose_network" \
  -v "$SCRIPT_DIR/..:/app" \
  -w /app \
  -e PLAYWRIGHT_FRONTEND_URL="http://frontend:5173" \
  -e PLAYWRIGHT_BACKEND_URL="http://backend:8080" \
  -e PLAYWRIGHT_ADMIN_URL="http://backend:8080/admin" \
  -e PLAYWRIGHT_MAILHOG_URL="http://mailhog:8025" \
  -e E2E_ADMIN_USERNAME="${E2E_ADMIN_USERNAME:-admin}" \
  -e E2E_ADMIN_PASSWORD="${E2E_ADMIN_PASSWORD:-Admin123!}" \
  mcr.microsoft.com/playwright:v1.54.2-noble \
  bash -lc 'npm ci --include=dev >/tmp/npm-ci.log && npm run test:e2e:ci'
