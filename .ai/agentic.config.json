{
  "version": 1,
  "baseBranch": "main",
  "tracker": "github",
  "validation": {
    "commands": [
      "git diff --check origin/main...HEAD"
    ]
  },
  "labels": {
    "enabled": false
  },
  "qaGate": false,
  "ci": {
    "maxWaitMinutes": 0
  },
  "reviewChecklist": null,
  "closeKeywords": [
    "zamyka",
    "naprawia",
    "rozwiązuje"
  ],
  "prTitleTemplate": "{prefix}({area}): {summary}{issueRef}",
  "ticketKeyPattern": "GSWEB-[0-9]+"
}
